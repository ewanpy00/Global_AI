# Copy to .env and fill in. Without TAVILY_API_KEY and at least one provider key,
# Freshgate starts in demo mode on bundled fixtures (fictional data).

TAVILY_API_KEY=

# Model providers, routed through the embedded Bifrost gateway. Set one or more.
# Paid:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free tiers (no card): Groq (console.groq.com), Gemini (aistudio.google.com).
# GROQ_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=   # free ":free" models are capped at ~50 requests/day: too few for this app
# Fully local and free: install Ollama, `ollama pull llama3.1:8b`, then:
# OLLAMA_BASE_URL=http://localhost:11434
#
# Free-tier tips: FRESHGATE_CONCURRENCY=2 and TAVILY_SEARCH_DEPTH=basic.
# `make models` lists the model ids your keys can use.

# Model per pipeline step, as provider/model. Defaults depend on which keys are set
# (Anthropic: claude-haiku-5-5 extracts, claude-opus-5-5 judges).
# FRESHGATE_EXTRACT_MODEL=anthropic/claude-haiku-5-5
# FRESHGATE_JUDGE_MODEL=anthropic/claude-opus-5-5
# FRESHGATE_CHAT_MODEL=anthropic/claude-haiku-5-5
# Bifrost tries these, in order, when the primary provider fails.
# FRESHGATE_FALLBACK_MODELS=openai/gpt-5-mini

# TAVILY_SEARCH_DEPTH=advanced     # basic = 1 credit, advanced = 2 credits per search
# TAVILY_MAX_RESULTS=5
# FRESHGATE_MAX_CLAIMS=12
# FRESHGATE_CONCURRENCY=4
# FRESHGATE_CONNECTOR_MODE=annotate  # off | report | annotate | correct
# FRESHGATE_VERIFY_TIMEOUT_SEC=120
# FRESHGATE_MAX_RETRIES=3            # Bifrost retries 429s/5xx with backoff
# FRESHGATE_ADDR=:8080
# FRESHGATE_DEMO=1                   # force demo mode even with keys set
